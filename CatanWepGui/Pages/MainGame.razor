        if (CurrentPhaseId == 0) {
            if (FirstPicsList[CurrentColorId][0] == 0 && FirstPicsList[CurrentColorId][1] == 0) {
                if (CurrentColorId < ActivePlayers.Count - 1) {
                    AdvanceCurrentColorIdArray();
                    CurrentColorId++;
                    HasRolled = false;
                    DiceRoll = "?";

                }
                else {
                    AdvanceCurrentColorIdArray();
                    CurrentColorId = 0;
                    CurrentPhaseId = 1;
                    HasRolled = false;
                    DiceRoll = "?";

                }
            }
            else {
                if (FirstPicsList[CurrentColorId][0] == 0) {
                    await Js.InvokeVoidAsync("alert", $"Du musst noch {FirstPicsList[CurrentColorId][1]} Straßen bauen");
                }
