    public async Task Ertragerwirtschafter()
    {
        if (CurrentPhaseId != 2 || ThiefPending || HasWon || Busy) return;
        Busy = true;
        try
        {
            if (DiceRoll != "?") {
                var resources = await Js.InvokeAsync<Dictionary<string, List<object>>>("Ertrag.erwirtschaftung", Int32.Parse(DiceRoll), ThiefTile);

                foreach (var color in resources["Sheep"])
                {
                    foreach (var player in ActivePlayers.Where(p => p.Color == color.ToString()))
                    {
                        player.RessourceCards.Add(new ACards(ECards.Sheep,true,false,false));
                    }
                }
                foreach (var color in resources["Clay"]) {
                    foreach (var player in ActivePlayers.Where(p => p.Color == color.ToString()))
                    {
                        player.RessourceCards.Add(new ACards(ECards.Clay,true,false,false));
                    }
                }
                foreach (var color in resources["Stone"]) {
                    foreach (var player in ActivePlayers.Where(p => p.Color == color.ToString()))
                    {
                        player.RessourceCards.Add(new ACards(ECards.Ore,true,false,false));
                    }
                }
                foreach (var color in resources["Wheat"]) {
                    foreach (var player in ActivePlayers.Where(p => p.Color == color.ToString()))
                    {
                        player.RessourceCards.Add(new ACards(ECards.Wheat,true,false,false));
                    }
                }
                foreach (var color in resources["Wood"]) {
                    foreach (var player in ActivePlayers.Where(p => p.Color == color.ToString()))
                    {
                        player.RessourceCards.Add(new ACards(ECards.Wood,true,false,false));
                    }
                }

            }

            CurrentPhaseId = 3;
            PlayerMove = true;
            if (DiceRoll == "7")
            {
                Discard();
                await StartThief();
            }
        }
        finally
        {
            Busy = false;
        }
    }

    // --- räuber offen -> bis er gesetzt is is alles andere gesperrt
    public async Task StartThief()
    {
        ThiefPending = true;
        await Js.InvokeVoidAsync("Thief.lock");
    }

    // --- klick aufs tile, gleiches tile zählt nicht als bewegen
    public async Task PlaceThief(int tile)
    {
        if (!ThiefPending || Busy || tile == ThiefTile) return;
        Busy = true;
        try
        {
            ThiefTile = tile;
            ThiefPending = false;
            await Js.InvokeVoidAsync("Thief.createThief", tile, true);
            await Js.InvokeVoidAsync("Thief.unlock");
            await Steal(tile);
        }
        finally
        {
            Busy = false;
        }
    }

    // --- 1 zufällige karte von wem der am tile wohnt (zufällig wer, wenns mehrere sind)
    public async Task Steal(int tile)
    {
        var colors = await Js.InvokeAsync<string[]>("Thief.neighbours", tile);
        var player = ActivePlayers[CurrentColorId];
        var victims = ActivePlayers
            .Where(p => p != player && colors.Contains(p.Color) && p.RessourceCards.Any(c => BaseCards.Contains(c.Id)))
            .ToList();
        if (victims.Count == 0) return;

        var victim = victims[Random.Shared.Next(victims.Count)];
        var pool = victim.RessourceCards.Where(c => BaseCards.Contains(c.Id)).ToList();
        var card = pool[Random.Shared.Next(pool.Count)];
        victim.RessourceCards.Remove(card);
        ActivePlayers[CurrentColorId].RessourceCards.Add(card);
    }

    // --- 7: wer mehr als 7 karten hat wirft die hälfte ab (zufällig)
    public void Discard()
    {
        foreach (var p in ActivePlayers)
        {
            var pool = p.RessourceCards.Where(c => BaseCards.Contains(c.Id)).ToList();
            if (pool.Count <= 7) continue;
            foreach (var card in pool.OrderBy(_ => Random.Shared.Next()).Take(pool.Count / 2).ToList())
            {
                p.RessourceCards.Remove(card);
            }
        }
    }

    // --- resource von der man am wenigsten hat, 0 zählt auch
    public ECards LeastCommon(Player player)
    {
        return BaseCards.OrderBy(id => player.RessourceCards.Count(c => c.Id == id)).First();
    }

    public async Task BuyDevCard()
    {
        if (!CanBuild || Busy) return;
        var player = ActivePlayers[CurrentColorId];
        if (!Pay(player, ECards.Sheep, ECards.Wheat, ECards.Ore)) return;

        List<ACards> possibleCards =
        [
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.Knight, true, true, false),
            new ACards(ECards.WinPoint, true, true, false),
            new ACards(ECards.WinPoint, true, true, false),
            new ACards(ECards.WinPoint, true, true, false),
            new ACards(ECards.WinPoint, true, true, false),
            new ACards(ECards.WinPoint, true, true, false),
            new ACards(ECards.Monopol, true, true, true),
            new ACards(ECards.Monopol, true, true, true),
            new ACards(ECards.Monopol, true, true, true),
            new ACards(ECards.YearsOfPlenty, true, true, true),
            new ACards(ECards.YearsOfPlenty, true, true, true),
            new ACards(ECards.YearsOfPlenty, true, true, true),
        ];
        ACards randomCard = possibleCards[Random.Shared.Next(possibleCards.Count)];

        if (randomCard.Id == ECards.Knight)
        {
            player.RessourceCards.Add(randomCard);
            Rittermacht();
        }

        if (randomCard.Id == ECards.WinPoint)
        {
            player.RessourceCards.Add(randomCard);
            GiveWinPoints(1);
        }

        if (randomCard.Id == ECards.Monopol)
        {
            var leastCommon = LeastCommon(player);
            player.RessourceCards.Add(randomCard);
            foreach (var p in ActivePlayers.Where(p => p != player))
            {
                var toMove = p.RessourceCards.Where(card => card.Id == leastCommon).ToList();
                foreach (var card in toMove)
                {
                    p.RessourceCards.Remove(card);
                    player.RessourceCards.Add(card);
                }
            }
        }

        if (randomCard.Id == ECards.YearsOfPlenty)
        {
            var leastCommon = LeastCommon(player);
            player.RessourceCards.Add(randomCard);
            for (int i = 0; i < 3; i++)
            {
                player.RessourceCards.Add(new ACards(leastCommon, true, false, false));
            }
        }

        await Win();
        if (randomCard.Id == ECards.Knight && !HasWon)
        {
            await StartThief();
        }
    }

