    // --- rittermacht: ab 3 rittern, und man muss mehr haben als der der sie grad hat
    public void Rittermacht()
    {
        var player = ActivePlayers[CurrentColorId];
        var knights = player.RessourceCards.Count(c => c.Id == ECards.Knight);
        if (knights < 3) return;

        var playerWithRittermacht = ActivePlayers.FirstOrDefault(p => p.RessourceCards.Any(c => c.Id == ECards.Rittermacht));
        if (playerWithRittermacht == player) return;
        if (playerWithRittermacht != null)
        {
            if (knights <= playerWithRittermacht.RessourceCards.Count(c => c.Id == ECards.Knight)) return;
            playerWithRittermacht.WinPoints -= 2;
            playerWithRittermacht.RessourceCards.Remove(playerWithRittermacht.RessourceCards.First(c => c.Id == ECards.Rittermacht));
        }
        GiveWinPoints(2);
        player.RessourceCards.Add(new ACards(ECards.Rittermacht, true, true, false));
    }

