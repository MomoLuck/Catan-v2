@code {
    // --- erst nach dem rendern scrollen, vorher gibts die seite noch nicht
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("autoScroll.scroller");
        }
    }

    // --- seite verlassen -> scroll aus, sonst scrollt das menü weiter
    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("autoScroll.stop");
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

}